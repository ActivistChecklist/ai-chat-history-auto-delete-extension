# Copy to .env and fill in. `.env` is gitignored; `.env.example` is committed.
# Loaded automatically by `yarn build` and `yarn release`.

# 1Password secret reference for the Chrome extension CRX signing key.
# This is a POINTER, not the key itself — the private key never leaves 1Password
# except into a temp file during signing. Find it in the 1Password app:
# right-click the field -> "Copy Secret Reference".
OP_SIGNING_KEY_REF="op://<vault>/<item>/private key"

# Which 1Password account owns that vault. Required when more than one account is
# connected to the CLI (`op account list`), because an unscoped `op read` cannot tell
# which account holds the vault.
OP_ACCOUNT=""

# AMO (addons.mozilla.org) API credentials for `yarn publish:firefox`, as 1Password secret
# references. Create the key pair at https://addons.mozilla.org/developers/addon/api/key/
# ("JWT issuer" is the key, "JWT secret" is the secret). Alternatively export
# WEB_EXT_API_KEY and WEB_EXT_API_SECRET directly; those win over these references.
OP_AMO_API_KEY_REF="op://<vault>/<item>/jwt issuer"
OP_AMO_API_SECRET_REF="op://<vault>/<item>/jwt secret"

# Chrome Web Store API for `yarn publish:chrome`. The publisher ID is in the Developer
# Dashboard's publisher settings (it is not a secret). The service account's JSON key goes
# in 1Password, whole, in one field; this is the secret reference to that field.
CWS_PUBLISHER_ID=""
OP_CWS_SERVICE_ACCOUNT_REF="op://<vault>/<item>/service account json"
